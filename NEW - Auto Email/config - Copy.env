# ------------------------------------------------------------------
# Daily Sales Report - Swapnil merchant configuration
# Edit this file, save, then re-run DailySalesReport.exe
# ------------------------------------------------------------------
#
# Keys read by the program:
#   SQL_SERVER, SQL_DATABASE, SQL_AUTH, SQL_USER, SQL_PASSWORD
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM, SMTP_USE_TLS
#   REPORT_RECIPIENT, SMS_RECIPIENTS, REPORT_DATE_MODE, DRY_RUN
#
# SQL_SERVER with a backslash: quote or double backslashes, e.g.
#   SQL_SERVER="Harshil\pcamerica"

# --- SQL Server (pcAmerica CRE) ---
SQL_SERVER=Harshil\pcamerica
SQL_DATABASE=cresql
SQL_AUTH=sql
SQL_USER=sa
SQL_PASSWORD=pcAmer1ca

# --- SMTP (outgoing email) ---
# For Gmail: SMTP_PASSWORD must be a Google App Password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=harshil@jdgurus.com
SMTP_PASSWORD=hllu otlp dhkl fkxh
SMTP_FROM=Daily Reports <harshil@jdgurus.com>
SMTP_USE_TLS=true

# --- Recipient ---
# REQUIRED for sending email (comma-separated). All store reports go ONLY
# to these addresses. dbo.Setup store email fields are NOT used.
REPORT_RECIPIENT=harshil@jdgurus.com

# --- Other ---
# Default date behavior when no --date/--start/--end is passed:
#   latest     -> most recent sales date found in SQL
#   yesterday  -> calendar yesterday
#   today      -> calendar today
REPORT_DATE_MODE=yesterday
DRY_RUN=false