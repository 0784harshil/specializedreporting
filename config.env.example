# ===================================================================
# Specialized Reporting — Sample Configuration Template (config.env.example)
# Copy this file to 'config.env' next to Specialized_Reporting.exe
# ===================================================================

# --- SQL Server Connection (pcAmerica CRE POS) ---
SQL_SERVER=Harshil\pcamerica
SQL_DATABASE=cresqlvick
SQL_AUTH=sql
SQL_USER=sa
SQL_PASSWORD=pcAmer1ca

# --- SMTP Outgoing Email (Gmail / Office365) ---
# For Gmail: Use a 16-character App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Daily Reports <your.email@gmail.com>
SMTP_USE_TLS=true

# --- Report Recipients & Filters ---
REPORT_RECIPIENT=owner@example.com
SMS_RECIPIENTS=
REPORT_DATE_MODE=yesterday
DRY_RUN=false
REPORT_SECTIONS=deletes,departments,employees,fixed_tax,hourly,kpis,payments,price_changes,top_items,transactions,voids
ATTACH_XLSX=true
ATTACH_CSV=true

# --- Automated Daily Schedule ---
SCHEDULE_TIME=07:00
SCHEDULE_ENABLED=true

# --- GitHub Remote Updates ---
GITHUB_REPO=0784harshil/specializedreporting
AUTO_CHECK_UPDATES=true
